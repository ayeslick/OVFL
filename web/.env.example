# OVRFLO static runtime configuration.
#
# Production is fail-closed: every value below is required, addresses and
# anchors must match a verified fresh-generation deployment artifact, RPC URLs
# must be HTTPS, and deprecated *.alchemyapi.io hosts are rejected. Local
# bootstrap writes an explicit local profile; Vercel production refuses it.

NEXT_PUBLIC_RUNTIME_PROFILE=production
NEXT_PUBLIC_CHAIN_ID=1

# Fresh-generation deployment identity. Copy these from the verified deployment
# artifact produced by tools/scripts/write-deployment-artifact.mjs.
NEXT_PUBLIC_OVRFLO_FACTORY=0x1111111111111111111111111111111111111111
NEXT_PUBLIC_OVRFLO_LENS=0x2222222222222222222222222222222222222222
NEXT_PUBLIC_FACTORY_DEPLOYMENT_BLOCK=00000000
NEXT_PUBLIC_FACTORY_DEPLOYMENT_BLOCK_HASH=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
NEXT_PUBLIC_PROJECTION_SCHEMA_VERSION=1
NEXT_PUBLIC_ABI_VERSION=1

# Stream lockup, vaults, and lendings are discovered from the factory at runtime.
# Do not set NEXT_PUBLIC_SABLIER_LOCKUP_ADDRESS, NEXT_PUBLIC_OVRFLO_ADDRESS, or
# NEXT_PUBLIC_OVRFLO_LENDING — those vars are obsolete.

# Server-only build inputs. The build re-verifies the exact artifact against
# this RPC before Next emits a bundle. These values are never browser-bundled.
OVRFLO_DEPLOYMENT_ARTIFACT=../deployments/production.json
DEPLOYMENT_RPC_URL=https://history.example-rpc.com

# Ordinary reads preserve this operator order: primary, then comma-separated
# fallbacks. There is no implicit public production fallback. A revert is
# returned immediately and is never replayed on another provider.
NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/public-browser-key
NEXT_PUBLIC_RPC_FALLBACK_URLS=https://mainnet.example-rpc.com,https://backup.example-rpc.com

# Absolute deployed site origin for static social metadata.
NEXT_PUBLIC_SITE_ORIGIN=https://overflow.finance

# Local profile (written by tools/scripts/write-env.sh; never use on Vercel
# production):
#   NEXT_PUBLIC_RUNTIME_PROFILE=local
#   NEXT_PUBLIC_CHAIN_ID=1
#   NEXT_PUBLIC_OVRFLO_FACTORY=<verified local artifact factory>
#   NEXT_PUBLIC_OVRFLO_LENS=<verified local artifact lens>
#   NEXT_PUBLIC_FACTORY_DEPLOYMENT_BLOCK=<artifact block>
#   NEXT_PUBLIC_FACTORY_DEPLOYMENT_BLOCK_HASH=<artifact hash>
#   NEXT_PUBLIC_PROJECTION_SCHEMA_VERSION=1
#   NEXT_PUBLIC_ABI_VERSION=1
#   NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
